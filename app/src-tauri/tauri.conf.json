{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tsudev-cwico",
  "version": "26.11.1001",
  "identifier": "com.tsudev.cwico",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "tsudev-cwico - Windows Debloater",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "decorations": true,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../data/safety-db.json": "data/safety-db.json",
      "../../data/tweaks.json": "data/tweaks.json"
    },
    "copyright": "Copyright (c) 2026 tsudev",
    "category": "Utility",
    "shortDescription": "Deep Windows debloater and software removal toolkit",
    "longDescription": "Scan every corner of Windows (installed programs, UWP/AppX packages, services, scheduled tasks and autostart entries), then remove what you do not need, safely. Every item is classified Safe, Caution or Critical; critical system components cannot be removed at all. A System Restore Point and .reg backups are taken before anything changes.",
    "publisher": "tsudev",
    "homepage": "https://tsudev.com",
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "English",
          "Vietnamese"
        ],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "language": [
          "en-US"
        ],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tsudev-org/tsudev-cwico/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMDU5NzhFODY4QkU3Q0UKUldUTzU0dUdqcGNGT293UVN1Q28zbWhjNXdqL2o3NEM1OHRCWlVIQkdNWjZEZWNER1Y5S01RSlEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
