---
// Khung chung: <head> theo ECOSYSTEM_IDENTITY mục 2.2, đầu trang, chân trang nối về tsudev.com (mục 4).
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/site.css';
import { REPO_URL, SAN_PHAM, SITE } from '../lib/noi-dung';

interface Props {
  tieuDe?: string;      // Tên trang; bỏ trống ở trang chủ
  moTa: string;         // 120-160 ký tự (check-dist.mjs canh)
  duongDan: string;     // ví dụ "/tai-ve/"
  coLoc?: boolean;      // trang có bộ lọc -> nạp /js/loc.js
}
const { tieuDe, moTa, duongDan, coLoc = false } = Astro.props;
const title = tieuDe ? `${tieuDe} - ${SAN_PHAM} | tsudev` : `${SAN_PHAM} | tsudev`;
const ogTitle = tieuDe ? `${tieuDe} - ${SAN_PHAM}` : SAN_PHAM;
const url = `${SITE}${duongDan}`;
const nam = new Date().getFullYear();
const menu = [
  { href: '/tai-ve/', ten: 'Tải về' },
  { href: '/an-toan/', ten: 'Cơ chế an toàn' },
  { href: '/co-so-du-lieu/', ten: 'Quy tắc' },
  { href: '/tinh-chinh/', ten: 'Tinh chỉnh' },
  { href: '/dong-lenh/', ten: 'Dòng lệnh' },
  { href: '/nhat-ky/', ten: 'Nhật ký' },
];
const dangO = (href: string) => duongDan.startsWith(href);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'tsudev-cwico',
  alternateName: 'cwico',
  operatingSystem: 'Windows 10, Windows 11',
  applicationCategory: 'UtilitiesApplication',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'VND' },
  license: 'https://opensource.org/licenses/MIT',
  url: SITE,
  downloadUrl: `${SITE}/tai-ve/`,
  publisher: { '@type': 'Organization', name: 'tsudev', url: 'https://tsudev.com' },
};
---
<!doctype html>
<html lang="vi" data-theme="light">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={moTa}>
    <meta name="theme-color" content="#EEF4FB" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0F1B2D" media="(prefers-color-scheme: dark)">
    <meta name="color-scheme" content="light dark">
    <link rel="canonical" href={url}>
    <meta property="og:site_name" content="tsudev">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="vi_VN">
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={moTa}>
    <meta property="og:image" content={`${SITE}/og-image.png`}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:url" content={url}>
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.webmanifest">
    {duongDan === '/' && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
    {coLoc && <script src="/js/loc.js" defer></script>}
  </head>
  <body data-platform="web">
    <a class="bo-qua" href="#noi-dung">Bỏ qua tới nội dung</a>
    <header class="dau-trang">
      <div class="khung dau-trang__trong">
        <a class="thuong-hieu" href="/" aria-label="cwico - Trang chủ">
          <img src="/brand/logo-mark.png" alt="" width="34" height="42">
          <span>cwico</span>
        </a>
        <nav aria-label="Chính">
          <ul class="menu">
            {menu.map((m) => (
              <li><a href={m.href} aria-current={dangO(m.href) ? 'page' : undefined}>{m.ten}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main id="noi-dung">
      <slot />
    </main>
    <footer class="chan-trang">
      <div class="khung chan-trang__trong">
        <div class="chan-trang__cot">
          <a class="thuong-hieu thuong-hieu--nho" href="https://tsudev.com" target="_blank" rel="noopener noreferrer">
            <img src="/brand/logo-mark.png" alt="" width="24" height="29">
            <span>tsudev</span>
          </a>
          <p>(c) {nam} tsudev. cwico là phần mềm mã nguồn mở theo giấy phép MIT, một sản phẩm của
            <a href="https://tsudev.com" target="_blank" rel="noopener noreferrer">tsudev</a> - hệ sinh thái sản phẩm và công cụ phần mềm tại tsudev.com.</p>
        </div>
        <ul class="chan-trang__lien-ket">
          <li><a href="https://tsudev.com/terms" target="_blank" rel="noopener noreferrer">Điều khoản sử dụng</a></li>
          <li><a href="https://tsudev.com/privacy" target="_blank" rel="noopener noreferrer">Chính sách riêng tư</a></li>
          <li><a href="https://tsudev.com/projects" target="_blank" rel="noopener noreferrer">Sản phẩm khác</a></li>
          <li><a href="/bao-mat/">Bảo mật</a></li>
          <li><a href={REPO_URL} target="_blank" rel="noopener noreferrer">Mã nguồn</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
